# Copy this file to .env and fill in your credentials from https://api.podcastindex.org.
# .env is ignored by git, so the secret never reaches the repository.
PODCASTINDEX_API_KEY=
PODCASTINDEX_API_SECRET=

# Optional
# PODCASTINDEX_BASE_URL=https://api.podcastindex.org/api/1.0
# USER_AGENT=OnAirAPI/1.0
# REQUEST_TIMEOUT_SECONDS=15
